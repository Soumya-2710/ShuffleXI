{
  "name": "football-game",
  "version": "1.0.0",
  "description": "Full-Stack MERN Football Squad Building Game",
  "scripts": {
    "start": "node frontend/backend/server.js",
    "dev": "npm --prefix frontend run dev",
    "frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix frontend run seed",
    "seed:all": "npm --prefix frontend run seed:all",
    "seed:pl": "npm --prefix frontend run seed:pl",
    "seed:laliga": "npm --prefix frontend run seed:laliga",
    "seed:seriea": "npm --prefix frontend run seed:seriea",
    "seed:bundesliga": "npm --prefix frontend run seed:bundesliga",
    "seed:ligue1": "npm --prefix frontend run seed:ligue1",
    "extract:images": "npm --prefix frontend run extract:images",
    "extract:all": "npm --prefix frontend run extract:all",
    "sync:images": "npm --prefix frontend run sync:images",
    "build": "npm --prefix frontend run build",
    "docker:up": "docker compose up",
    "docker:up:build": "docker compose up --build",
    "docker:up:d": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:down:v": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:seed": "docker compose run --rm backend npm run seed",
    "docker:seed:all": "docker compose run --rm backend npm run seed:all",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down"
  },
  "keywords": [
    "mern",
    "react",
    "nodejs",
    "express",
    "mongodb",
    "football",
    "soccer",
    "squad-builder",
    "vite"
  ],
  "author": "Soumyadeep",
  "license": "ISC"
}
