# ==========================================
# Football Game — Environment Configuration
# ==========================================

# Database
MONGO_URI=mongodb://localhost:27017/football-game
MONGO_PORT=27017
MONGO_DB=football-game

# Backend Service
PORT=5000
BACKEND_PORT=5000
NODE_ENV=development

# Frontend Service
FRONTEND_PORT=3000
BACKEND_URL=http://localhost:5000

# Docker Polling for file-watching (set to true on Windows/WSL2 mounted volumes)
CHOKIDAR_USEPOLLING=true
