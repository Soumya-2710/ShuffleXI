{
  "name": "football-game-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"VITE,EXPRESS\" -c \"cyan,green\" \"vite\" \"node --watch backend/server.js\"",
    "dev:frontend": "vite",
    "dev:backend": "node --watch backend/server.js",
    "seed": "node backend/seed/seed.js",
    "seed:all": "node backend/seed/seed.js",
    "seed:pl": "node backend/seed/seedPremierLeague.js",
    "seed:laliga": "node backend/seed/seedLaliga.js",
    "seed:seriea": "node backend/seed/seedSerieA.js",
    "seed:bundesliga": "node backend/seed/seedBundesliga.js",
    "seed:ligue1": "node backend/seed/seedLigue1.js",
    "extract:images": "node backend/scripts/extractPlayerImages.js",
    "extract:all": "node backend/scripts/extractPlayerImages.js --all",
    "sync:images": "node backend/scripts/extractPlayerImages.js --sync",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.0"
  }
}
