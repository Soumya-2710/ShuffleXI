# ==========================================
# Docker Compose Environment Template
# Copy to .env if you wish to customize Docker Compose defaults
# ==========================================

# Port Mappings on Host Machine
FRONTEND_PORT=3000
BACKEND_PORT=5000
MONGO_PORT=27017

# Database Name inside MongoDB
MONGO_DB=football-game

# Internal container networking (handled automatically by docker-compose.yml)
# MONGO_URI=mongodb://mongodb:27017/football-game
# BACKEND_URL=http://backend:5000

# File change watching for live reload
CHOKIDAR_USEPOLLING=true
